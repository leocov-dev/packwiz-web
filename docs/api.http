# API checks

# modpack/ ---
### GET static modpack files
GET {{host}}/packwiz/packA/mods/balm.pw.toml

# v1/ --------------------------------------------------------------------------
### POST login user
POST {{apiRoot}}/v1/auth/login
Content-Type: application/x-www-form-urlencoded

username = admin &
password = !admin1234567890

### POST logout user
POST {{apiRoot}}/v1/auth/logout

### GET Health check status
GET {{apiRoot}}/v1/health
Accept: application/json

# v1/user/ ---------------------------------------------------------------------

### GET current user
GET {{apiRoot}}/v1/user/current

# v1/admin/ ---------------------------------------------------------------------

### GET List all users
GET {{apiRoot}}/v1/admin/users
    ?page=1
    &pageSize=10
    &userType=user

# v1/packwiz/ ------------------------------------------------------------------

# v1/packwiz/loaders ------------------------------------------------------------------
### GET all possible packwiz loaders
GET {{apiRoot}}/v1/packwiz/loaders
Accept: application/json

# v1/packwiz/pack ------------------------------------------------------------------
### GET all packwiz modpacks
GET {{apiRoot}}/v1/packwiz/pack
Accept: application/json

### GET all packwiz modpacks (filtered)
GET {{apiRoot}}/v1/packwiz/pack
    ?filters=published
    &filters=draft
Accept: application/json

### POST create a new modpack
POST {{apiRoot}}/v1/packwiz/pack
Content-Type: application/json

{
  "name": "My Creative Pack",
  "minecraft": {
    "latest": true
  },
  "loader": {
    "name": "fabric",
    "latest": true
  }
}

### HEAD check if modpack exists
HEAD {{apiRoot}}/v1/packwiz/pack/packA

### GET a packs details
GET {{apiRoot}}/v1/packwiz/pack/packA

### DELETE remove a modpack
DELETE {{apiRoot}}/v1/packwiz/pack/packC

### GET pack public link
GET {{apiRoot}}/v1/packwiz/pack/packC/link

### POST add a mod
POST {{apiRoot}}/v1/packwiz/pack/packA
Content-Type: application/json

{
  "modrinth": {
    "name": "waystones"
  }
}

### DELETE remove a named mod
DELETE {{apiRoot}}/v1/packwiz/pack/packA/mod/balm

### PATCH update a named mod (responds {"updated": bool}; 400 if pinned; 409 if an update is in progress for the pack)
PATCH {{apiRoot}}/v1/packwiz/pack/packA/mod/balm/update

### PATCH update all mods in a pack (partial success; responds {updated, skipped, failed, upToDate, notChecked};
# 200 even when some mods failed - inspect "failed"; 409 if an update is already in progress for the pack)
PATCH {{apiRoot}}/v1/packwiz/pack/packA/update-all

### POST start an async update check (editors). 202 {jobId, status} when a job was enqueued;
# 200 with the existing job when one is already queued/running, or a check finished < 10 min ago
# (add ?force=true to bypass that cache). Poll GET .../updates for results.
POST {{apiRoot}}/v1/packwiz/pack/packA/updates/check?force=false

### GET stored update check state (viewers). {status: idle|queued|running|done|failed, checkedAt, error?,
# results: [{modId, updateAvailable, updateString?, error?}], availableCount (excludes pinned)}
GET {{apiRoot}}/v1/packwiz/pack/packA/updates

### PATCH update a mods side
PATCH {{apiRoot}}/v1/packwiz/pack/packA/mod/balm/side
Content-Type: application/json

{
  "side": "server"
}

### PATCH pin a named modpack to prevent updates
PATCH {{apiRoot}}/v1/packwiz/pack/packA/mod/balm/pin

### PATCH un-pin a named modpack to prevent updates
PATCH {{apiRoot}}/v1/packwiz/pack/packA/mod/balm/unpin